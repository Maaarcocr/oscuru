// App target signing, Debug and Release. project.yml points the app target's signing settings
// at these OSCURU_* variables, so they apply to the app target only (the Swift package targets
// cannot use a provisioning profile).
//
// Local development: automatic signing.
OSCURU_APP_BUNDLE_ID = com.rudilosso.oscuru
OSCURU_CODE_SIGN_STYLE = Automatic
OSCURU_CODE_SIGN_IDENTITY = Apple Development
OSCURU_DEVELOPMENT_TEAM =
OSCURU_PROVISIONING_PROFILE =

// A build service writes this file just before archiving to switch to distribution signing.
#include? "Signing.local.xcconfig"
