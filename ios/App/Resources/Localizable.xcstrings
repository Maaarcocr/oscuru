    "library.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a RAW photo (Apple ProRAW or DNG) to start. JPEG and HEIC work too. Your originals are never changed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una foto RAW (Apple ProRAW o DNG) per iniziare. Vanno bene anche JPEG e HEIC. Gli originali non vengono mai modificati."
          }
        }
      }
    },
