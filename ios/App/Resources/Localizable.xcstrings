    "error.credits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your OpenRouter account is out of credit, or the key reached its own limit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account OpenRouter ha finito il credito, oppure la chiave ha raggiunto il suo limite."
          }
        }
      }
    },
    "error.key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter refused the key. Connect again in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter ha rifiutato la chiave. Collega di nuovo l’account in Impostazioni."
          }
        }
      }
    },
    "error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection to OpenRouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a OpenRouter."
          }
        }
      }
    },
    "error.rate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests right now. Wait a moment and try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste in questo momento. Aspetta un attimo e riprova."
          }
        }
      }
    },
    "error.request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model did not accept the request. Try another model in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non ha accettato la richiesta. Prova un altro modello in Impostazioni."
          }
        }
      }
    },
    "error.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model had a problem answering. Try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello ha avuto un problema nel rispondere. Riprova."
          }
        }
      }
    },
    "filters.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a look below to use it on other photos. You can also ask the assistant to save or apply one."
          }
