    "settings.frames.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a frames value to the camera in zero processing: at ×8 it takes eight RAW frames and merges them into one RAW file with less noise. Beside the dial, Bracket takes them at darker and brighter exposures, and Every leaves time between them. The frames are kept with the photo, so the assistant can merge them another way. Hold still while it shoots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge alla fotocamera, senza elaborazione, il valore dei fotogrammi: a ×8 scatta otto fotogrammi RAW e li fonde in un solo file RAW con meno rumore. Accanto alla ghiera, Bracketing li scatta a esposizioni più scure e più chiare, e Ogni lascia del tempo tra l’uno e l’altro. I fotogrammi restano con la foto, così l’assistente può fonderli in un altro modo. Resta fermo mentre scatta."
          }
        }
      }
    },
