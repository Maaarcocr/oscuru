    "privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuru has no account, no server and no analytics. Photos and edits stay on this iPhone. When you use the assistant, previews of the photo, its settings and its capture details go to OpenRouter and the model you chose, under your OpenRouter account. Your key is kept in the iPhone keychain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuru non ha account, server né analytics. Foto e modifiche restano su questo iPhone. Quando usi l’assistente, anteprime della foto, le sue impostazioni e i dati di scatto vanno a OpenRouter e al modello che hai scelto, sotto il tuo account OpenRouter. La chiave è conservata nel portachiavi dell’iPhone."
          }
        }
      }
    },
