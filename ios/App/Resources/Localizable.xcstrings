    "library.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a photo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una foto"
          }
        }
      }
    },
    "library.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo: Oscuru keeps exactly what the sensor saw, with no processing. Or add one you already have. Then say how you want it to look."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta una foto: Oscuru tiene esattamente ciò che ha visto il sensore, senza elaborazioni. Oppure aggiungine una che hai già. Poi di’ come la vuoi."
          }
        }
      }
    },
    "library.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos yet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna foto"
          }
        }
      }
    },
