{
  "expo": {
    "name": "Oscuru",
    "slug": "oscuru",
    "version": "0.1.0",
    "scheme": "oscuru",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.rudilosso.oscuru",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UIFileSharingEnabled": false
      }
    },
    "locales": {
      "en": "./assets/locales/en.json",
      "it": "./assets/locales/it.json"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
